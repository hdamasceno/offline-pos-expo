# offline-pos-expo needs no secrets. Every variable here is optional.

# Base URL of the inventory API in server/ (npm run server).
# Leave empty to use the in-app demo server. On a phone, use your computer's LAN IP.
EXPO_PUBLIC_API_URL=

# Used by `npm run server` only.
PORT=4000
# Share of requests that fail before processing (0..1).
FAILURE_RATE=0
# Share of requests that are processed but whose response is "lost" (0..1).
LOST_RESPONSE_RATE=0
