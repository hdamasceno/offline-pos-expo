{
  "name": "offline-pos-expo",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-crypto": "~58.0.8",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.15",
    "serve": "^14.2.8",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint --max-warnings 0",
    "coverage": "jest --coverage",
    "server": "node server/index.ts",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:hooks": "node --test \"scripts/*.test.mjs\"",
    "screenshots": "SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts",
    "prepare": "husky"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  },
  "description": "Offline-first point-of-sale in React Native (Expo) with an idempotent, ordered sync outbox.",
  "license": "MIT",
  "author": "Henry Lima",
  "engines": {
    "node": ">=22.18"
  }
}
